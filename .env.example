# ==============================================================================
# AEGIS — Autonomous Evidence-driven Governance & Intelligent Safety
# Root Environment Configuration Template
# ==============================================================================

# Server & Network Ports
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000

# Safety Engine & Demo Controls
# Setting AEGIS_DEMO_MODE=true guarantees repeatable deterministic decision loops
AEGIS_DEMO_MODE=true
SIMULATOR_RANDOM_SEED=42
DELIBERATE_VERIFICATION_FAILURE=true

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,*

# LLM Provider Configuration
# Options: 'mock' (deterministic fallback reasoning, default), 'openai' (Ollama / vLLM / OpenAI)
AEGIS_LLM_PROVIDER=mock

# Local / Self-Hosted LLM (Ollama / vLLM)
# When running inside Docker, host.docker.internal reaches the host Ollama instance
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Optional Cloud API Keys (Leave blank for offline / hackathon evaluation)
OPENAI_API_KEY=
GEMINI_API_KEY=
