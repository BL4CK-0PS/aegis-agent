# AEGIS Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Provider Configuration
# Supported providers: 'openai' (Ollama / vLLM / OpenAI), 'gemini', or 'mock'
AEGIS_LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Optional Cloud API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Safety & Simulator Defaults
SIMULATOR_RANDOM_SEED=42
DELIBERATE_VERIFICATION_FAILURE=true
